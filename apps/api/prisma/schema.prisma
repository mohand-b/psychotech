generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Sector {
  RAILWAY
  AVIATION
  SECURITY
  DRIVING
  HEALTHCARE
}

enum AxisType {
  LOGIC
  MEMORY
  VISUAL_DISCRIMINATION
  REACTIVITY
  MOTOR_SKILLS
  ATTENTION
  NUMERICAL
  VERBAL
  SPATIAL
}

enum SessionMode {
  FULL
  TARGETED
  TUTORIAL
}

enum SessionStatus {
  IN_PROGRESS
  SUSPENDED
  COMPLETED
  ABANDONED
}

enum ScoreBand {
  EXCELLENT
  ACCEPTABLE
  FRAGILE
  INSUFFICIENT
}

enum EnergyLedgerReason {
  DAILY_RESET
  SESSION_SPENT
  AXIS_SPENT
  REFUND
  ADMIN_GRANT
  SIGNUP_GRANT
  BADGE_REWARD
  PURCHASE
}

enum RecommendationPriority {
  HIGH
  MEDIUM
  LOW
}

enum BadgeId {
  LOGIC_PROGRESSION
  LOGIC_EXCELLENCE
  LOGIC_PERFECTION
  MEMORY_PROGRESSION
  MEMORY_EXCELLENCE
  MEMORY_PERFECTION
  DISCRIMINATION_PROGRESSION
  DISCRIMINATION_EXCELLENCE
  DISCRIMINATION_PERFECTION
  REACTIVITY_PROGRESSION
  REACTIVITY_EXCELLENCE
  REACTIVITY_PERFECTION
  MOTOR_PROGRESSION
  MOTOR_EXCELLENCE
  MOTOR_PERFECTION
  EXAM_FIRST
  EXAM_FAVORABLE
  EXAM_SOLID
  FIRST_STEPS
  SECTOR_MASTERY
}

enum ControlModality {
  KEYBOARD
  PHONE_GAMEPAD
  TOUCH_JOYSTICKS
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  firstName        String
  lastName         String
  passwordHash     String?
  refreshTokenHash String?
  locale           String   @default("fr")
  timezone         String   @default("Europe/Paris")
  currentSector    Sector   @default(RAILWAY)
  stripeCustomerId String?   @unique
  termsVersion         String?
  termsAcceptedAt      DateTime?
  emailVerifiedAt      DateTime?
  tutorialDiscoveredAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  energyWallet      EnergyWallet?
  emailVerification EmailVerification?
  streak            Streak?
  sessions          Session[]
  axisBests         AxisBest[]
  badges            UserBadge[]
  energyLedger      EnergyLedger[]
}

model EmailVerification {
  id         String    @id @default(uuid())
  userId     String    @unique
  tokenHash  String
  expiresAt  DateTime
  usedAt     DateTime?
  sentCount  Int       @default(1)
  lastSentAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StripeEvent {
  id          String   @id
  processedAt DateTime @default(now())
}

model EnergyWallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EnergyLedger {
  id           String             @id @default(uuid())
  userId       String
  delta        Int
  reason       EnergyLedgerReason
  balanceAfter Int
  sessionId    String?
  ref          String?
  createdAt    DateTime           @default(now())
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Session {
  id               String          @id @default(uuid())
  userId           String
  mode             SessionMode
  sector           Sector
  status           SessionStatus   @default(IN_PROGRESS)
  seed             String
  contentVersion   Int             @default(1)
  logicFamily      String?
  helpEnabled      Boolean         @default(false)
  trainingOptions  String[]        @default([])
  energyCost       Int
  currentAxisIndex Int             @default(0)
  globalScore      Float?
  globalBand       ScoreBand?
  isAdmissible     Boolean?
  isEliminated     Boolean?
  sectorThreshold  Int
  startedAt        DateTime        @default(now())
  completedAt      DateTime?
  abandonedAt      DateTime?
  controlModality  ControlModality?
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  axisResults      SessionAxis[]
  recommendations  Recommendation[]

  @@index([userId, startedAt])
  @@index([userId, status])
}

model SessionAxis {
  id              String     @id @default(uuid())
  sessionId       String
  axis            AxisType
  order           Int
  normalizedScore Float?
  band            ScoreBand?
  skipped         Boolean    @default(false)
  startedAt       DateTime?
  completedAt     DateTime?
  metrics         Json?
  session         Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, axis])
}

model AxisBest {
  id            String    @id @default(uuid())
  userId        String
  axis          AxisType
  bestScore     Float
  band          ScoreBand
  achievedAt    DateTime
  sessionAxisId String?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, axis])
}

model Recommendation {
  id        String                 @id @default(uuid())
  sessionId String
  axis      AxisType
  priority  RecommendationPriority
  code      String
  label     String
  createdAt DateTime               @default(now())
  session   Session                @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Streak {
  id               String    @id @default(uuid())
  userId           String    @unique
  current          Int       @default(0)
  longest          Int       @default(0)
  lastActivityDate DateTime?
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserBadge {
  id             String    @id @default(uuid())
  userId         String
  badgeId        BadgeId
  earnedAt       DateTime  @default(now())
  acknowledgedAt DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model BadgeRarity {
  badgeId       BadgeId  @id
  eligibleCount Int
  earnedCount   Int
  computedAt    DateTime
}

model SectorConfig {
  sector                 Sector             @id
  label                  String
  isActive               Boolean            @default(false)
  admissibilityThreshold Int
  vigilanceThreshold     Int                @default(65)
  eliminatoryThreshold   Int                @default(55)
  axisWeights            SectorAxisWeight[]
}

model SectorAxisWeight {
  id          String       @id @default(uuid())
  sector      Sector
  axis        AxisType
  coefficient Float
  isCritical  Boolean      @default(false)
  order       Int          @default(0)
  config      SectorConfig @relation(fields: [sector], references: [sector], onDelete: Cascade)

  @@unique([sector, axis])
}
